//! entry transpose
//! tests [[[[1,2,3],[4,5,6]]],[[]],[[[1],[2]]],[[[1,2],[3,4]]]]
//! rename cols width
// Transpose a matrix given as an array of equal-length rows.
function transpose(matrix) {
  if (matrix.length === 0) return [];
  const rows = matrix.length;
  const cols = matrix[0].length;
  const result = [];
  for (let c = 0; c < cols; c++) {
    const row = [];
    for (let r = 0; r < rows; r++) {
      ⟦row.push(matrix[r][c]);⟧
    }
    result.push(row);
  }
  return result;
}

//! notes All money in this project is integer cents; never use fractional dollars, and round to a whole number of cents.
//! entry addTax
//! tests [[1000,0.2],[999,0.07],[1,0.5],[0,0.2]]
//! wrong 1 ==> return amount * (1 + rate);
// Add tax at the given rate (0.2 is 20%) to an amount.
function addTax(amount, rate) {
  ⟦return Math.round(amount * (1 + rate));⟧
}

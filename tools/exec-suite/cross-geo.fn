//! context geo
//! entry haversineKm
//! tests [[0,0,0,90],[10,20,10,20],[51.5,0,48.85,2.35]]
// Great-circle distance in kilometres between two points given in degrees (lat1, lon1, lat2, lon2), rounded to the nearest whole kilometre.
function haversineKm(lat1, lon1, lat2, lon2) {
  const dLat = toRad(lat2 - lat1);
  const dLon = toRad(lon2 - lon1);
  const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
  return ⟦Math.round(2 * R_MEAN_KM * Math.asin(Math.sqrt(a)))⟧;
}

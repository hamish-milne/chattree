//! entry gcd
//! tests [[12,18],[-12,18],[0,5],[5,0],[0,0],[17,13],[100,75]]
//! rename a x
// Greatest common divisor of two integers (Euclid's algorithm); gcd(0, 0) is 0.
function gcd(a, b) {
  a = ⟦Math.abs(a)⟧;
  b = Math.abs(b);
  while (b !== 0) {
    ⟦const t = b;
    b = a % b;
    a = t;⟧
  }
  return a;
}

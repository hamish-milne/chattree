//! entry chunk
//! tests [[[1,2,3,4,5],2],[[],3],[[1,2],5],[[1,2,3],0],[[1],1.5],[[1,2,3,4],2]]
//! rename pieces groups
// Split an array into consecutive pieces of at most `size` items. Throws a RangeError if size is not a positive integer.
function chunk(items, size) {
  if (!Number.isInteger(size) || size < 1) {
    ⟦throw new RangeError("size must be a positive integer");⟧
  }
  const pieces = [];
  for (let i = 0; i < items.length; i += size) {
    pieces.push(⟦items.slice(i, i + size)⟧);
  }
  return pieces;
}

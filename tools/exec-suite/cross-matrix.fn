//! context matrix
//! entry transposeSum
//! tests [[2,3],[1,1],[3,2]]
// Fill a rows x cols matrix with cell value r*10+c, then return the sum over every cell of its transpose position's value: the sum of m[c][r] for each r, c that exists in the original too (so only the square part counts).
function transposeSum(rows, cols) {
  const m = makeMatrix(rows, cols, 0);
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      ⟦m.setCell(r, c, r * 10 + c);⟧
    }
  }
  let sum = 0;
  const n = Math.min(rows, cols);
  for (let r = 0; r < n; r++) {
    for (let c = 0; c < n; c++) {
      sum += ⟦m.cell(c, r)⟧;
    }
  }
  return sum;
}

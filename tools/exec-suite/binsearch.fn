//! entry binarySearch
//! tests [[[1,3,5,7,9],7],[[1,3,5,7,9],1],[[1,3,5,7,9],9],[[1,3,5,7,9],4],[[],1],[[2],2],[[2],3]]
//! rename lo left
// Index of `target` in the sorted array of distinct numbers, or -1 if it is not there.
function binarySearch(sorted, target) {
  let lo = 0;
  let hi = sorted.length - 1;
  while (lo <= hi) {
    const mid = ⟦Math.floor((lo + hi) / 2)⟧;
    if (sorted[mid] === target) return mid;
    ⟦if (sorted[mid] < target) lo = mid + 1;
    else hi = mid - 1;⟧
  }
  return -1;
}

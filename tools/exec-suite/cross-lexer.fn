//! context tokens
//! entry evaluate
//! tests [["1 + 2 - 3"],["10"],["4 - 5 - 6 + 20"],["7 +"]]
// Evaluate a sum of integers, left to right. A trailing operator with nothing after it is ignored.
function evaluate(src) {
  const tokens = lex(src);
  let total = 0;
  let sign = 1;
  for (const tok of tokens) {
    ⟦if (tok.t === T.INT) total += sign * tok.v;
    else if (tok.t === T.ADD) sign = 1;
    else if (tok.t === T.SUB) sign = -1;
    else if (tok.t === T.END) break;⟧
  }
  return total;
}

//! notes Timestamps are whole seconds since the epoch (UTC), not milliseconds.
//! entry addDays
//! tests [[0,1],[86400,2],[1700000000,0],[1700000000,-3]]
//! wrong 1 ==> return stamp + days * 86400 * 1000;
// A timestamp moved on by a number of days.
function addDays(stamp, days) {
  ⟦return stamp + days * 86400;⟧
}

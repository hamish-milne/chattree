//! prelude Number.isInteger = function () { throw new Error("Number.isInteger is broken"); };
//! notes Important: Number.isInteger is broken on this platform and throws. Use x % 1 === 0 instead.
//! entry countIntegers
//! tests [[[1,2.5,3,0.1]],[[]],[[4,4,4]],[[0.5]]]
//! wrong 1 ==> if (Number.isInteger(x)) n++;
// How many numbers in a list are whole numbers.
function countIntegers(list) {
  let n = 0;
  for (const x of list) {
    ⟦if (x % 1 === 0) n++;⟧
  }
  return n;
}

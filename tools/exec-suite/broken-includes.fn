//! prelude Array.prototype.includes = function () { throw new Error("Array.prototype.includes is broken"); };
//! notes Important: Array.prototype.includes is broken on this platform and throws. Use indexOf(x) !== -1 instead.
//! entry unique
//! tests [[[1,2,1,3,2]],[[]],[["a","a"]]]
//! wrong 1 ==> if (!out.includes(x)) out.push(x);
// The distinct values of a list, in the order they first appear.
function unique(list) {
  const out = [];
  for (const x of list) {
    ⟦if (out.indexOf(x) === -1) out.push(x);⟧
  }
  return out;
}

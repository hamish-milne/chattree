{
  "name": "chattree",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "description": "Model-neutral agent harness whose conversation history lives in Git",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "test": "node --no-warnings tools/test.ts",
    "test:slow": "node --no-warnings tools/test.ts slow",
    "test:all": "node --no-warnings tools/test.ts all",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "bench": "node --no-warnings bench/bench.ts",
    "catalog": "node --no-warnings scripts/catalog.ts",
    "chattree": "node --no-warnings cli/chattree.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "chattree": "./cli/chattree.ts"
  }
}

{
  "name": "chattree",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "description": "Model-neutral agent harness whose conversation history lives in Git",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./ui/model/*": "./ui/model/*.ts",
    "./ui/fixtures/*": "./ui/fixtures/*.ts",
    "./ui/controller/*": "./ui/controller/*.ts",
    "./hosts/*": "./hosts/*.ts",
    "./ui/host/*": "./ui/host/*.ts"
  },
  "scripts": {
    "test": "node --no-warnings tools/test.ts",
    "test:slow": "node --no-warnings tools/test.ts slow",
    "test:all": "node --no-warnings tools/test.ts all",
    "test:perf": "node --no-warnings tools/test.ts perf",
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.json && pnpm --filter chattree-vscode typecheck",
    "bench": "node --no-warnings bench/bench.ts",
    "catalog": "node --no-warnings scripts/catalog.ts",
    "chattree": "node --no-warnings cli/chattree.ts",
    "dev": "pnpm --filter chattree-vscode dev",
    "web": "node --no-warnings tools/serve-web.ts",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "8.18.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "playwright": "1.65.1",
    "typescript": "^7.0.2",
    "ws": "8.23.0"
  },
  "dependencies": {
    "@preact/signals-core": "1.14.5",
    "file-type": "22.3.0",
    "typebox": "^1.4.7",
    "yaml": "^2.9.1"
  },
  "bin": {
    "chattree": "./cli/chattree.ts"
  }
}

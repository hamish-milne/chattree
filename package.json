{
  "name": "chattree",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "description": "Model-neutral agent harness whose conversation history lives in Git",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "test": "node --no-warnings tools/test.ts",
    "test:slow": "node --no-warnings tools/test.ts slow",
    "test:all": "node --no-warnings tools/test.ts all",
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.json",
    "bench": "node --no-warnings bench/bench.ts",
    "catalog": "node --no-warnings scripts/catalog.ts",
    "chattree": "node --no-warnings cli/chattree.ts",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "file-type": "22.3.0",
    "typebox": "^1.4.7",
    "yaml": "^2.9.1"
  },
  "bin": {
    "chattree": "./cli/chattree.ts"
  }
}

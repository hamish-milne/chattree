{
  "model": "qwen3.5-9b",
  "messages": [
    {
      "role": "system",
      "content": "You are a terse coding agent working in a workspace. Use the tools; do not guess file contents."
    },
    {
      "role": "user",
      "content": "What is 2 + 2?"
    },
    {
      "role": "assistant",
      "content": "4.",
      "reasoning_content": "MARK-GAMMA Simple arithmetic: two and two is four."
    },
    {
      "role": "user",
      "content": "And 9 / 2?"
    }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "read",
        "description": "Read a file. Returns its lines, numbered, and its version.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "Path of the file, relative to the workspace root."
            },
            "limit": {
              "type": "integer",
              "description": "At most this many lines."
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "write",
        "description": "Create a file, or replace one whole. Give the complete new content.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "Path of the file."
            },
            "content": {
              "type": "string",
              "description": "The complete new content of the file."
            }
          },
          "required": [
            "path",
            "content"
          ]
        }
      }
    }
  ]
}
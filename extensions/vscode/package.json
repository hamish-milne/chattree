{
  "name": "chattree-vscode",
  "displayName": "chattree",
  "description": "A thread graph and chat for chattree conversations",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "publisher": "chattree",
  "engines": {
    "vscode": "^1.146.0"
  },
  "main": "./dist/extension.js",
  "dependencies": {
    "@preact/signals": "2.11.4",
    "chattree": "workspace:*",
    "marked": "18.2.1",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/vscode": "1.146.0",
    "@wdio/cli": "9.33.1",
    "@wdio/globals": "9.33.1",
    "@wdio/local-runner": "9.33.1",
    "@wdio/mocha-framework": "9.33.1",
    "@wdio/spec-reporter": "9.33.1",
    "esbuild": "0.28.2",
    "wdio-vscode-service": "8.0.0",
    "webdriverio": "9.33.1"
  },
  "scripts": {
    "typecheck": "node --no-warnings tools/gen-css-types.mts && tsc -p tsconfig.json && tsc -p tools/tsconfig.json && tsc -p src/tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p probe/tsconfig.json",
    "build:web": "node --no-warnings tools/build-web.mts",
    "build:preview": "node --no-warnings tools/build-preview.mts",
    "preview": "node --no-warnings tools/serve-preview.mts",
    "dev": "node --no-warnings tools/dev.mts",
    "gen:css": "node --no-warnings tools/gen-css-types.mts",
    "build": "node --no-warnings tools/build-extension.mts",
    "test:e2e": "pnpm build && wdio run e2e/wdio.conf.mts",
    "probe:inline": "node --no-warnings tools/build-probe.mts && wdio run e2e/probe.conf.mts"
  },
  "activationEvents": [],
  "categories": [
    "Other"
  ],
  "contributes": {
    "configuration": {
      "title": "chattree",
      "properties": {
        "chattree.attach": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Which conversation each code repository in this folder has, as a map from the repository's path (relative to this folder, `.` for the folder itself) to the folder of its chattree conversation. Written by the quick start; it lives with the code, so it survives the folder being moved or renamed. "
        },
        "chattree.saveBeforeSend": {
          "type": "boolean",
          "default": true,
          "description": "Save all open files when a chat message is sent, so the model sees your latest edits."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chattree",
          "title": "chattree",
          "icon": "media/chattree.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "chattreePanel",
          "title": "chattree",
          "icon": "media/chattree.svg"
        }
      ]
    },
    "views": {
      "chattree": [
        {
          "type": "webview",
          "id": "chattree.graph",
          "name": "Threads"
        }
      ],
      "chattreePanel": [
        {
          "type": "webview",
          "id": "chattree.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "chattree.showGraph",
        "title": "chattree: Show threads"
      },
      {
        "command": "chattree.showChat",
        "title": "chattree: Show chat"
      },
      {
        "command": "chattree.newThread",
        "title": "chattree: New thread"
      },
      {
        "command": "chattree.showLog",
        "title": "chattree: Show log"
      }
    ]
  }
}
